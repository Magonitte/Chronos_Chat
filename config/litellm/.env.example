# Variáveis usadas pelo serviço litellm no docker-compose
# Copie valores do .env na raiz do repo (fonte única: ../../.env.example)

LITELLM_MASTER_KEY=change-me-litellm-key
LLAMA_API_BASE=http://host.docker.internal:8080/v1

MEM0_API_URL=http://mem0:8000
ANYTHINGLLM_API_URL=http://anythingllm:3001
ANYTHINGLLM_API_KEY=change-me-anythingllm-dev-api-key
MEM0_TIMEOUT=5
MEM0_ADD_TIMEOUT=120
MEM0_SEARCH_LIMIT=5
MEM0_MIN_SCORE=0.35
NEWCHAT_MAX_OUTPUT_TOKENS=1536
NEWCHAT_DISABLE_THINKING=true
NEWCHAT_MAX_CONTEXT_MESSAGES=6
RAG_TIMEOUT=2
RAG_TOP_N=8
RAG_SCORE_THRESHOLD=0.25

ALLOWED_USER_IDS=jean,tati
CTX_TOTAL=131072
CTX_RESERVE_RESPONSE_PCT=0.20
CTX_BUDGET_CONVERSATION_PCT=0.30
CTX_BUDGET_MEM0_PCT=0.05
CTX_BUDGET_RAG_PCT=0.30
