# mem0 API server — variáveis usadas pelo serviço no docker-compose.yml
# Valores reais ficam no .env na raiz do repo (env_file do compose).
# Copie este arquivo só como referência; não é carregado automaticamente.

# --- Postgres (pgvector) ---
POSTGRES_HOST=mem0-postgres
POSTGRES_PORT=5432
POSTGRES_DB=mem0
POSTGRES_USER=mem0
POSTGRES_PASSWORD=change-me-mem0-postgres
APP_DB_NAME=mem0_app

# --- API mem0 ---
MEM0_PORT=8000
MEM0_JWT_SECRET=change-me-mem0-jwt-secret-min-32-chars
MEM0_AUTH_DISABLED=true
MEM0_TELEMETRY=false
# Placeholder até embedder/LLM local (F5+); servidor exige a variável
OPENAI_API_KEY=local-placeholder-not-used

# --- Build (Dockerfile) ---
MEM0_GIT_REF=main

# --- LiteLLM (rede interna — não expor mem0 à UI) ---
MEM0_API_URL=http://mem0:8000
