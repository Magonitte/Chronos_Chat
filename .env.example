# Chronos Chat — variáveis de ambiente (template)
# Copie para .env e preencha os valores
# Uso: cp .env.example .env  (ou copy no Windows)

# =============================================================================
# Compose
# =============================================================================
# Nome do projeto Docker (prefixo de containers e volumes)
COMPOSE_PROJECT_NAME=newchat

# =============================================================================
# LiteLLM (hub orquestrador)
# =============================================================================
# Porta do servico LiteLLM no host (acessivel via http://localhost:4000)
LITELLM_PORT=4000
# Chave mestra do LiteLLM — usada pelo LibreChat para autenticar chamadas
LITELLM_MASTER_KEY=change-me-litellm-key

# =============================================================================
# LibreChat (UI fina)
# =============================================================================
# Porta da interface web (http://localhost:3080)
LIBRECHAT_PORT=3080
# Somente endpoint custom (LiteLLM) — nao habilitar openAI, assistants, etc.
ENDPOINTS=custom
# Permitir cadastro de novos usuarios na UI
ALLOW_REGISTRATION=true
# Credenciais de criptografia do LibreChat (32 e 16 chars respectivamente)
CREDS_KEY=change-me-32-char-secret-key!!
CREDS_IV=change-me-16-char-iv!!
# Segredos JWT para tokens de sessao
JWT_SECRET=change-me-jwt-secret
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret
# Chave mestra do MeiliSearch (busca interna do LibreChat, desabilitada)
MEILI_MASTER_KEY=change-me-meili-master-key

# =============================================================================
# mem0 (memoria de longo prazo)
# =============================================================================
# Porta da API mem0 (http://localhost:8000)
MEM0_PORT=8000
# Credenciais do PostgreSQL (pgvector) usado pelo mem0
MEM0_POSTGRES_DB=mem0
MEM0_POSTGRES_USER=mem0
MEM0_POSTGRES_PASSWORD=change-me-mem0-postgres
# Nome do banco de aplicacao interno do mem0
MEM0_APP_DB_NAME=mem0_app
# Branch/tag do repo mem0 para build da imagem local
MEM0_GIT_REF=main
# Segredo JWT da API mem0
MEM0_JWT_SECRET=change-me-mem0-jwt-secret-min-32-chars
# Desabilitar telemetria do mem0
MEM0_TELEMETRY=false
# Desabilitar autenticacao na API mem0 (rede interna, sem exposicao externa)
MEM0_AUTH_DISABLED=true
# Placeholder obrigatorio — nao usado (embeddings sao locais)
MEM0_OPENAI_API_KEY=local-placeholder-not-used

# =============================================================================
# AnythingLLM (RAG / busca em documentos)
# =============================================================================
# Porta da API AnythingLLM (http://localhost:3001)
ANYTHINGLLM_PORT=3001
# Segredo JWT da API AnythingLLM
ANYTHINGLLM_JWT_SECRET=change-me-anythingllm-jwt-20chars-min
# Token opcional de protecao da UI
ANYTHINGLLM_AUTH_TOKEN=
# Desabilitar telemetria do AnythingLLM
ANYTHINGLLM_DISABLE_TELEMETRY=true
# Provedor de embeddings: native = MiniLM local (CPU/Xenova, sem usar llama.cpp)
ANYTHINGLLM_EMBEDDING_ENGINE=native
# Modelo de embedding local leve (nao usar Qwen 35B para embeddings)
ANYTHINGLLM_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# Tamanho maximo de chunk por documento em tokens
ANYTHINGLLM_EMBEDDING_MAX_CHUNK=1000
# API key gerada no onboarding do AnythingLLM (Settings → API Keys)
ANYTHINGLLM_API_KEY=change-me-anythingllm-dev-api-key

# =============================================================================
# llama.cpp (inferencia local no host Windows — FORA do Docker)
# =============================================================================
# Endpoint do llama-server que roda no host (:8080)
LLAMA_API_BASE=http://host.docker.internal:8080/v1

# =============================================================================
# Orquestracao LiteLLM (comunicacao interna entre servicos)
# =============================================================================
# URLs dos servicos internos na rede Docker newchat-net
MEM0_API_URL=http://mem0:8000
ANYTHINGLLM_API_URL=http://anythingllm:3001

# Timeout da busca de memorias no mem0 (segundos) — fail-open
MEM0_TIMEOUT=5
# Timeout da gravacao de memorias no mem0 (segundos) — operacao assincrona
MEM0_ADD_TIMEOUT=120
# Quantas memorias o mem0 retorna por busca
MEM0_SEARCH_LIMIT=5
# Score minimo de relevancia vetorial (0.0-1.0) para incluir memoria no contexto.
# Valores mais altos = menos memorias, porem mais precisas.
# Valores mais baixos = mais memorias, mas pode incluir ruido.
# Recomendado: 0.35-0.40 para evitar mistura de topicos diferentes.
MEM0_MIN_SCORE=0.38
# Timeout da busca RAG no AnythingLLM (segundos) — fail-open
RAG_TIMEOUT=2

# =============================================================================
# Latencia (cap de saida + historico enviado ao modelo)
# =============================================================================
# max_tokens base por request quando thinking esta OFF.
# Com thinking ON, o valor sobe para NEWCHAT_THINKING_MAX_TOKENS.
# Quanto menor, menor a latencia maxima porem respostas mais curtas.
NEWCHAT_MAX_OUTPUT_TOKENS=1536
# Numero maximo de mensagens do historico enviadas ao modelo por request.
# A conversa completa e preservada em metadata para POST-CALL.
NEWCHAT_MAX_CONTEXT_MESSAGES=6

# =============================================================================
# Thinking policy (F10) — ativacao automatica de reasoning por contexto
# =============================================================================
# Kill switch mestre — false desliga thinking para TODAS as requests.
# Nao requer redeploy, apenas restart do litellm apos alteracao.
NEWCHAT_THINKING_ENABLED=true
# max_tokens quando thinking esta ON (precisa de folga para raciocinio + resposta).
# Sobrescreve NEWCHAT_MAX_OUTPUT_TOKENS apenas para requests com thinking ativado.
NEWCHAT_THINKING_MAX_TOKENS=3072
# Numero minimo de chunks RAG retornados para ativar thinking em sintese multi-fonte.
# Se o RAG retornar menos chunks que este valor, nao ativa thinking so por RAG.
NEWCHAT_THINKING_RAG_CHUNKS=3
# Numero minimo de turnos (user + assistant) para considerar "historico longo".
# Atingido este limite + query nao trivial = thinking ativado.
NEWCHAT_THINKING_MIN_CONVERSATION_TURNS=6

# =============================================================================
# Orcamento de contexto (ctx_total=131072 para Qwen 35B)
# =============================================================================
# Total de tokens de contexto do modelo (--ctx-size 131072 no llama-server)
CTX_TOTAL=131072
# Percentual reservado para resposta (20% = ~26214 tokens)
CTX_RESERVE_RESPONSE_PCT=0.20
# Percentual do input para historico de conversa (30%)
CTX_BUDGET_CONVERSATION_PCT=0.30
# Percentual do input para memorias do mem0 (5%)
CTX_BUDGET_MEM0_PCT=0.05
# Percentual do input para chunks de RAG (30%)
CTX_BUDGET_RAG_PCT=0.30
# Tokens estimados por imagem no contexto (llama-server --image-min-tokens 1024)
CTX_IMAGE_TOKENS_PER_IMAGE=1024

# =============================================================================
# user_id (OBRIGATORIO — sem fallback)
# =============================================================================
# Lista de usuarios permitidos. O header X-User-Id DEVE conter um destes valores.
# Isolamento de memorias: jean nao ve memorias de tati e vice-versa.
ALLOWED_USER_IDS=jean,tati